<?xml version="1.0"?>
<package format="3">
  <name>ari_rgbd_sensors</name>
  <version>0.1.0</version>
  <description>ARI-specific RGBD sensors module and params files.</description>
  <author email="andrea.capodacqua@pal-robotics.com">Andrea Capodacqua</author>
  <maintainer email="andrea.capodacqua@pal-robotics.com">Andrea Capodacqua</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <build_depend condition="$PAL_DISTRO >= alum">pal_module_cmake</build_depend>
  <build_depend condition="$PAL_DISTRO >= alum">pal_configuration_cmake</build_depend>
  
  <exec_depend condition="$PAL_DISTRO >= alum">realsense2_camera</exec_depend>
  <exec_depend condition="$PAL_DISTRO >= alum">realsense_camera_cfg</exec_depend>
  <exec_depend condition="$PAL_DISTRO >= alum">realsense2_camera_deprecated</exec_depend>
  <exec_depend condition="$PAL_DITRO >= alum">realsense_deprecated_camera_cfg</exec_depend>
  
  <exec_depend>launch_pal</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>ros2launch</exec_depend>  

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
